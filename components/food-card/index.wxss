.food-card {
  overflow: hidden;
  border: 1rpx solid rgba(17, 23, 19, 0.08);
  border-radius: 42rpx;
  background: #ffffff;
  box-shadow: 0 18rpx 48rpx rgba(17, 23, 19, 0.06);
}

.food-card__visual {
  position: relative;
  height: 236rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.food-card__image {
  width: 100%;
  height: 100%;
}

.food-card__can {
  width: 166rpx;
  height: 166rpx;
  border-radius: 36rpx;
}

.food-card__status {
  position: absolute;
  right: 14rpx;
  bottom: 14rpx;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #ffffff;
  font-size: 17rpx;
  font-weight: 900;
}

.status--mint {
  background: #b6ff2c;
}

.status--yellow {
  background: #f7ff58;
}

.status--purple {
  color: #ffffff;
  background: #111713;
}

.status--gray {
  background: #eef0ec;
}

.food-card__body {
  display: flex;
  flex-direction: column;
  padding: 22rpx 22rpx 26rpx;
}

.food-card__brand {
  color: #7a817b;
  font-size: 18rpx;
  font-weight: 750;
}

.food-card__name {
  margin-top: 5rpx;
  overflow: hidden;
  font-size: 26rpx;
  font-weight: 950;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.food-card__meta {
  margin-top: 7rpx;
  overflow: hidden;
  color: #7a817b;
  font-size: 19rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.food-card__progress {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 17rpx;
  color: #7a817b;
  font-size: 17rpx;
  font-weight: 800;
}

.progress {
  flex: 1;
  height: 13rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e8ebe5;
}

.progress__fill {
  height: 100%;
  border-radius: inherit;
  background: #b6ff2c;
}

.food-card__latest {
  margin-top: 14rpx;
  color: #4b514c;
  font-size: 18rpx;
  font-weight: 800;
}

.food-card--compact .food-card__visual {
  height: 214rpx;
}

.food-card--compact .food-card__body {
  padding: 19rpx 20rpx 22rpx;
}

.food-card--compact .food-card__name {
  font-size: 24rpx;
}
