.home {
  padding-bottom: 220rpx;
}

.black-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 54rpx;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: #111713;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 900;
}

.hero {
  position: relative;
  min-height: 510rpx;
  overflow: hidden;
  border-radius: 58rpx;
  background-color: #b6ff2c;
  background-image: url("/assets/style/lime-dots.png");
  background-position: right 28rpx top 28rpx;
  background-repeat: no-repeat;
  background-size: 360rpx auto;
}

.hero__copy {
  position: relative;
  z-index: 2;
  width: 68%;
  padding: 48rpx 0 44rpx 42rpx;
}

.hero__eyebrow,
.section-kicker {
  display: inline-flex;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #ffffff;
  font-size: 20rpx;
  font-weight: 900;
}

.hero__title {
  display: flex;
  flex-direction: column;
  margin-top: 26rpx;
  font-size: 62rpx;
  font-weight: 950;
  line-height: 1.06;
  letter-spacing: -3rpx;
}

.hero__desc {
  display: block;
  width: 355rpx;
  margin-top: 17rpx;
  font-size: 23rpx;
  font-weight: 650;
}

.hero__action {
  width: auto;
  min-height: 78rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin: 28rpx 0 0;
  padding: 0 29rpx;
  border-radius: 25rpx;
  background: #111713;
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 900;
}

.hero__cat {
  position: absolute;
  right: -46rpx;
  bottom: 2rpx;
  width: 360rpx;
  height: 360rpx;
  border-radius: 66rpx;
  transform: rotate(-5deg);
}

.hero__tag {
  position: absolute;
  z-index: 2;
  right: 28rpx;
  top: 37rpx;
  font-size: 20rpx;
  font-weight: 900;
}

.quick-strip {
  width: calc(100% + 60rpx);
  margin: 24rpx -30rpx 0;
}

.quick-strip__inner {
  display: inline-flex;
  gap: 18rpx;
  padding: 0 30rpx 10rpx;
}

.quick-card {
  width: 262rpx;
  min-height: 148rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(17, 23, 19, 0.06);
  border-radius: 42rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 42rpx rgba(17, 23, 19, 0.05);
}

.quick-card image {
  width: 84rpx;
  height: 84rpx;
  flex: 0 0 auto;
  border-radius: 24rpx;
}

.quick-card > view {
  display: flex;
  flex-direction: column;
}

.quick-card > view text:first-child {
  font-size: 27rpx;
  font-weight: 950;
}

.quick-card > view text:last-child {
  margin-top: 6rpx;
  color: #7a817b;
  font-size: 18rpx;
  white-space: nowrap;
}

.restock-feature {
  margin-top: 28rpx;
  padding: 32rpx 30rpx 28rpx;
  border-radius: 50rpx;
  background-color: #f7ff58;
  background-image: url("/assets/style/lime-dots.png");
  background-position: right 26rpx top 22rpx;
  background-repeat: no-repeat;
  background-size: 320rpx auto;
}

.restock-feature__heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
}

.restock-feature__heading > view {
  display: flex;
  flex-direction: column;
}

.restock-feature__heading .section-kicker {
  padding: 0;
  background: transparent;
  color: #52611f;
}

.restock-feature__title {
  margin-top: 5rpx;
  font-size: 44rpx;
  font-weight: 950;
  letter-spacing: -2rpx;
}

.restock-feature__inner {
  min-height: 150rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 22rpx;
  padding: 20rpx;
  border-radius: 36rpx;
  background: #ffffff;
}

.restock-feature__inner image {
  width: 100rpx;
  height: 100rpx;
  flex: 0 0 auto;
  border-radius: 28rpx;
}

.restock-feature__inner > view {
  min-width: 0;
  display: flex;
  flex: 1;
  flex-direction: column;
}

.restock-feature__primary {
  font-size: 25rpx;
  font-weight: 950;
}

.restock-feature__secondary {
  margin-top: 8rpx;
  overflow: hidden;
  color: #7a817b;
  font-size: 18rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.restock-feature__link,
.section__link {
  flex: 0 0 auto;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: #111713;
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 900;
}

.food-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
}

.recent-list {
  overflow: hidden;
  border: 1rpx solid rgba(17, 23, 19, 0.08);
  border-radius: 42rpx;
  background: #ffffff;
}

.recent-item {
  min-height: 122rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx 22rpx;
  border-bottom: 1rpx solid rgba(17, 23, 19, 0.08);
}

.recent-item:last-child {
  border-bottom: 0;
}

.recent-item__swatch {
  width: 82rpx;
  height: 82rpx;
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  border-radius: 26rpx;
}

.recent-item__swatch image {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
}

.recent-item__copy {
  min-width: 0;
  display: flex;
  flex: 1;
  flex-direction: column;
}

.recent-item__name {
  overflow: hidden;
  font-size: 24rpx;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recent-item__meta {
  margin-top: 6rpx;
  overflow: hidden;
  color: #7a817b;
  font-size: 18rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recent-item__status {
  flex: 0 0 auto;
  padding: 10rpx 14rpx;
  border-radius: 999rpx;
  font-size: 18rpx;
  font-weight: 900;
}

.status-text--mint {
  background: #b6ff2c;
}

.status-text--yellow {
  background: #f7ff58;
}

.status-text--purple {
  color: #ffffff;
  background: #111713;
}

.status-text--gray {
  background: #eef0ec;
}

.empty-state__demo {
  width: 220rpx;
  min-height: 68rpx;
  margin: 22rpx auto 0;
  border-radius: 22rpx;
  background: #f7ff58;
  font-size: 22rpx;
  font-weight: 900;
}
