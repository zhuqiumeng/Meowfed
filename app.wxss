@import "/styles/tokens.wxss";

page {
  min-height: 100%;
  background: var(--c-bg-page-2, #f4f5f1);
  color: var(--c-ink-primary, #111713);
  font-family: var(--font-family-base);
  font-size: var(--fs-root, 28rpx);
}

view,
text,
image,
button,
input,
picker,
textarea {
  box-sizing: border-box;
}

button {
  font-family: inherit;
}

button::after {
  border: 0;
}

.page-shell {
  min-height: 100vh;
  padding: calc(env(safe-area-inset-top) + 30rpx) 30rpx 200rpx;
  overflow: hidden;
}

.topbar {
  min-height: 82rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.topbar__brand {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 40rpx;
  font-weight: 950;
  letter-spacing: -2rpx;
}

.topbar__logo {
  width: 70rpx;
  height: 70rpx;
  object-fit: contain;
}

.topbar__back,
.icon-button {
  min-width: 86rpx;
  height: 62rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 20rpx;
  border: 0;
  border-radius: 999rpx;
  background: #ffffff;
  box-shadow: 0 9rpx 28rpx rgba(17, 23, 19, 0.08);
  font-size: 22rpx;
  font-weight: 850;
}

.section {
  margin-top: 46rpx;
}

.section__header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 22rpx;
  margin-bottom: 22rpx;
}

.section__title {
  display: block;
  font-size: 40rpx;
  line-height: 1.15;
  font-weight: 950;
  letter-spacing: -1rpx;
}

.section__hint {
  display: block;
  margin-top: 6rpx;
  color: #7a817b;
  font-size: 21rpx;
}

.card {
  border: 1rpx solid rgba(17, 23, 19, 0.08);
  border-radius: 42rpx;
  background: #ffffff;
  box-shadow: 0 20rpx 54rpx rgba(17, 23, 19, 0.06);
}

.pill {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  padding: 8rpx 18rpx;
  border: 0;
  border-radius: 999rpx;
  background: #111713;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 850;
}

.primary-button,
.secondary-button,
.danger-button {
  min-height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 22rpx 30rpx;
  border: 0;
  border-radius: 32rpx;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.2;
}

.primary-button {
  color: #ffffff;
  background: #111713;
  box-shadow: 0 18rpx 34rpx rgba(17, 23, 19, 0.17);
}

.secondary-button {
  background: #ffffff;
}

.danger-button {
  color: #ffffff;
  background: #111713;
}

.primary-button[disabled],
.secondary-button[disabled] {
  color: #8b928c;
  background: #d5d9d3;
  box-shadow: none;
}

.empty-state {
  padding: 58rpx 34rpx;
  text-align: center;
}

.empty-state__icon {
  width: 110rpx;
  height: 110rpx;
  margin-bottom: 16rpx;
  object-fit: contain;
}

.empty-state__title {
  font-size: 30rpx;
  font-weight: 900;
}

.empty-state__text {
  margin-top: 10rpx;
  color: #7a817b;
  font-size: 22rpx;
  line-height: 1.6;
}
